<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme applied before Compose takes over. Kept minimal on purpose:
         the actual Material 3 theming is done in Compose (src/shared/theme/). -->
    <style name="Theme.Kern" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/kern_seed</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
